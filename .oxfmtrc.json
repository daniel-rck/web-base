{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": { "newlinesBetween": false },
  "sortPackageJson": false,
  "ignorePatterns": [
    "cli/dist/**",
    "cli/templates/**",
    "cli/template-tests/**",
    "bun.lock",
    "**/*.md"
  ]
}
