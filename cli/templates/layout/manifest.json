{
  "name": "layout",
  "description": "AppShell, AppHeader, AppNav, PageHeader, primitives, InstallButton, theme.css",
  "files": [
    { "from": "AppShell.tsx", "to": "src/lib/ui/AppShell.tsx" },
    { "from": "AppHeader.tsx", "to": "src/lib/ui/AppHeader.tsx" },
    { "from": "AppNav.tsx", "to": "src/lib/ui/AppNav.tsx" },
    { "from": "PageHeader.tsx", "to": "src/lib/ui/PageHeader.tsx" },
    { "from": "primitives.tsx", "to": "src/lib/ui/primitives.tsx" },
    { "from": "InstallButton.tsx", "to": "src/lib/ui/InstallButton.tsx" },
    { "from": "useInstallPrompt.ts", "to": "src/lib/ui/useInstallPrompt.ts" },
    { "from": "theme.css", "to": "src/lib/ui/theme.css" },
    { "from": "index.ts", "to": "src/lib/ui/index.ts" }
  ],
  "dependencies": {
    "lucide-react": "^1.16.0"
  },
  "postInstall": [
    "Import theme: add `@import \"./lib/ui/theme.css\";` to your `src/index.css`",
    "Wrap your app in `<AppShell>...</AppShell>`",
    "Set the color accent: edit the `--accent-h` value in theme.css",
    "Suggested accents: Hausverwaltung→250 (Slate-Blau), Tennisturnier→155 (Emerald), ErinnerMich→285 (Indigo)"
  ]
}
